load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@rules_distroless//distroless:defs.bzl", "group", "passwd")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//:transition.bzl", "multi_arch")

passwd(
    name = "passwd",
    entries = [{
        "uid": 100,
        "gid": 65534,
        "home": "/var/www",
        "shell": "/usr/sbin/nologin",
        "username": "www-data",
    }],
)

group(
    name = "group",
    entries = [{
        "name": "www-data",
        "gid": 65534,
    }],
)

tar(
    name = "sh",
    mtree = [
        "./var/lib/nginx/body type=dir",
        "./run/nginx.pid type=file",
    ],
)

pkg_files(
    name = "config",
    srcs = [
        ":fastcgi.conf",
        ":nginx.conf",
    ],
    prefix = "etc/nginx",
    strip_prefix = strip_prefix.from_pkg(),
)

pkg_tar(
    name = "config.tar",
    srcs = [":config"],
)

oci_image(
    name = "image",
    architecture = select({
        "@platforms//cpu:arm64": "arm64",
        "@platforms//cpu:x86_64": "amd64",
    }),
    cmd = [
        "-g",
        "daemon off;",
    ],
    entrypoint = ["/usr/sbin/nginx"],
    os = "linux",
    tags = ["manual"],
    tars = [
        ":sh",
        ":passwd",
        ":group",
        ":config.tar",
        "@nginx-bookworm//:flat",
    ],
)

multi_arch(
    name = "images",
    image = ":image",
    platforms = [
        "//:linux-arm64",
        "//:linux-amd64",
    ],
)

oci_image_index(
    name = "index",
    images = [":images"],
)

oci_push(
    name = "push",
    image = ":index",
    remote_tags = ["latest"],
    repository = "nginx",
)
